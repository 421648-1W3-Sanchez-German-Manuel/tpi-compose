# DEC-18: the RS256 keys do not enter the image or the repo
secrets/

# `.env` alone is NOT enough: a `.env.bak` from a backup, a `.env.local` or a
# `.env.old` carry the same secrets and get in all the same. The glob covers
# them all; the explicit exception is the example, which has no real value.
.env
.env.*
!.env.example

# Local override of build paths (this machine's own folder structure, not the
# one the README expects)
docker-compose.override.yml
