# Copy to vault/server/.env (gitignored). Values for the shared server.

# Tailscale auth key created with tag:vault (not reusable, not ephemeral).
TS_AUTHKEY=

# MagicDNS name of the Vault node. Micros and Agents use https://<name>:8200.
TS_HOSTNAME=tpi-vault

# What Vault advertises. Use the full MagicDNS name of this tailnet.
VAULT_API_ADDR=https://tpi-vault.tail767776.ts.net:8200
VAULT_CLUSTER_ADDR=https://tpi-vault.tail767776.ts.net:8201
