# Copiar a .env y completar. El .env NUNCA va al repo.
# Un secreto que entro al historial de git solo se arregla rotandolo.

# Password de root de MySQL. Obligatoria.
MYSQL_ROOT_PASSWORD=

# kid de la clave RS256 activa. Tiene que coincidir con el nombre del .pem
# publico en ./secrets/jwks/<kid>.pem (lo genera ../users/scripts/gen-dev-keys.sh,
# ver README).
JWT_ACTIVE_KID=dev

# URL del front, para armar los enlaces de activacion y de reset. Es el proxy
# reverso, que es la unica puerta publica del stack.
USERS_FRONT_URL=http://localhost:3000

# Flag Secure de las cookies de sesion (fu_at/fu_rt). Este compose no termina
# TLS en ningun lado, asi que queda en false — con true el navegador nunca
# las manda y no hay forma de loguearse. Si algun dia este stack corre detras
# de TLS real, cambiar a true.
COOKIE_SECURE=false

# Servicios que el Gateway rutea, separados por coma y sin espacios. Reemplaza
# entera la lista del application.yml del gateway. ACA se da de alta un equipo
# nuevo: registrarse en Eureka no alcanza, fuera de esta lista es 404.
# Despues de tocarla: docker compose up -d api-gateway
GATEWAY_ALLOWLIST=users-service

# Concurrencia maxima por destino (BulkheadFilter). Bajarlo a 1 y mandar carga
# en paralelo es la forma de comprobar que el bulkhead esta vivo.
BULKHEAD_MAX_CONCURRENT=64

# ADMIN inicial (RF-USR-01). Si dejas la password vacia, el servicio genera una
# y la imprime UNA sola vez en el log de arranque.
ADMIN_BOOTSTRAP_EMAIL=admin@frc.utn.edu.ar
ADMIN_BOOTSTRAP_PASSWORD=

# SPEC §16.1 - institutional domain(s) allowed for student sign-up, comma-separated
# if there is more than one. Must match the users-service default when unset.
REGISTRATION_ALLOWED_DOMAINS=frc.utn.edu.ar

# Costura con Cursos (Tema 02): topico Kafka donde Cursos publica el evento de
# padron resuelto y de donde lo consume users-service. Estandar de plataforma:
# topico por dominio (contrato Kafka del equipo de notificaciones).
TOPIC_COURSE_VALIDATION=course-events

# GitHub OAuth App (vinculacion). Crear en
# https://github.com/settings/developers → OAuth Apps → New OAuth App.
# Homepage URL:        http://localhost:3000
# Authorization callback URL: http://localhost:3000/vinculacion/callback
# Hacen falta LAS DOS cosas para prenderlo: GITHUB_LINK_ENABLED=true y un
# GITHUB_CLIENT_ID no vacio. Con cualquiera de las dos apagada la vinculacion
# no existe — los endpoints contestan provider-not-supported y el onboarding
# se cierra con el tour solo, sin dejar a nadie trabado (DEC-GL-05).
GITHUB_LINK_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Si lo dejas vacio se arma solo como {USERS_FRONT_URL}/vinculacion/callback.
# Completalo unicamente si la callback URL de la OAuth App apunta a otro lado.
GITHUB_REDIRECT_URI=
GITHUB_SCOPE=
# Cuanto vive el `state` de OAuth entre /start y /callback (DEC-GL-08).
GITHUB_STATE_TTL=PT5M
