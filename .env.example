# Copiar a .env y completar. El .env NUNCA va al repo.
# Un secreto que entro al historial de git solo se arregla rotandolo.

# Password de root de MySQL. Obligatoria.
MYSQL_ROOT_PASSWORD=

# kid de la clave RS256 activa. Tiene que coincidir con el nombre del .pem
# publico en ./secrets/jwks/<kid>.pem (lo genera scripts/gen-dev-keys.sh).
JWT_ACTIVE_KID=dev

# URL del front, para armar los enlaces de activacion y de reset. Es el proxy
# reverso, que es la unica puerta publica del stack.
USERS_FRONT_URL=http://localhost:3000

# Servicios que el Gateway rutea, separados por coma y sin espacios. Reemplaza
# entera la lista del application.yml del gateway. ACA se da de alta un equipo
# nuevo: registrarse en Eureka no alcanza, fuera de esta lista es 404.
# Despues de tocarla: docker compose up -d api-gateway
GATEWAY_ALLOWLIST=users-service,echo-service

# Concurrencia maxima por destino (BulkheadFilter). Bajarlo a 1 y mandar carga
# en paralelo es la forma de comprobar que el bulkhead esta vivo.
BULKHEAD_MAX_CONCURRENT=64

# ADMIN inicial (RF-USR-01). Si dejas la password vacia, el servicio genera una
# y la imprime UNA sola vez en el log de arranque.
ADMIN_BOOTSTRAP_EMAIL=admin@frc.utn.edu.ar
ADMIN_BOOTSTRAP_PASSWORD=

# Cliente de servicio de echo-service. Lo da de alta scripts/seed-echo-client.sh
ECHO_CLIENT_ID=echo-service
ECHO_CLIENT_SECRET=
