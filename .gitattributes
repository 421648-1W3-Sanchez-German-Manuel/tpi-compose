# The .sh scripts run inside Linux containers and from bash. With CRLF, bash
# fails with a `$'\r': command not found` that says nothing about the cause.
# This forces them to LF on checkout, also on Windows.
*.sh text eol=lf
*.inc text eol=lf
nginx/* text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.yml text eol=lf
