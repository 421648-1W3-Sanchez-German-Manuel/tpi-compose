{
  "panels": [
    {
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval])) by (job, method)",
          "legendFormat": "{{job}} {{method}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Requests / sec",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval])) by (job, status)",
          "legendFormat": "{{job}} {{status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Response Codes",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{job=~\"$job\"}[$__rate_interval])) by (job, method) / sum(rate(http_server_requests_seconds_count{job=~\"$job\"}[$__rate_interval])) by (job, method) * 1000",
          "legendFormat": "{{job}} {{method}}",
          "refId": "A"
        }
      ],
      "title": "Avg Response Time (ms)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(http_server_requests_active_seconds_count{job=~\"$job\"}) by (job)",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Active Requests",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{job=~\"$job\", area=\"heap\"}",
          "legendFormat": "{{job}} heap",
          "refId": "A"
        },
        {
          "expr": "jvm_memory_used_bytes{job=~\"$job\", area=\"nonheap\"}",
          "legendFormat": "{{job}} nonheap",
          "refId": "B"
        }
      ],
      "title": "JVM Memory Used",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\"$job\"}",
          "legendFormat": "{{job}} live",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_peak_threads{job=~\"$job\"}",
          "legendFormat": "{{job}} peak",
          "refId": "B"
        }
      ],
      "title": "JVM Threads",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"$job\"}[$__rate_interval])",
          "legendFormat": "{{job}} {{cause}} {{action}}",
          "refId": "A"
        }
      ],
      "title": "JVM GC Pause",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "max": 1,
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "title": "Process CPU Usage",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "spring-boot",
    "microservices"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus"
        },
        "includeAll": true,
        "multi": true,
        "name": "job",
        "query": "label_values(http_server_requests_seconds_count, job)",
        "refresh": 2,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Plataforma Gamificada - Microservices"
}
